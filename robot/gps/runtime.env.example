# Copy to /etc/cerber/gps.env on the Jetson, owned by root, mode 0600.
# Use stable by-id names from this modem. IF02 belongs to ModemManager: never use it.
GPS_NMEA_DEVICE=/dev/serial/by-id/usb-Quectel_EG25-GC-if01-port0
GPS_AT_DEVICE=/dev/serial/by-id/usb-Quectel_EG25-GC-if03-port0
# Explicit IPv4 addresses from the existing VPN deployment. No wildcard binding.
GPS_MQTT_HOST=REQUIRED_BROKER_VPN_IPV4
GPS_MQTT_BIND_ADDRESS=REQUIRED_JETSON_VPN_IPV4
GPS_MQTT_PORT=11883
GPS_MQTT_TOPIC=cerber/gps/data

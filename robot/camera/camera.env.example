# Replace every placeholder on the Jetson; keep the filled file out of git.
# The built-in Lite3 camera exposes /test on its motion host, port 8554.
CERBER_CAMERA_RTSP_URL="rtsp://<ROBOT_MOTION_HOST_IP>:8554/test"
CERBER_CAMERA_SRT_URI="srt://<SRT_RECEIVER_VPN_IP>:<SRT_PORT>?streamid=publish:video/normal_cam&pkt_size=1316&latency=300"
CERBER_CAMERA_VPN_ADDRESS="<JETSON_VPN_IP>"
CERBER_CAMERA_VPN_CIDR="<APPROVED_VPN_CIDR>"
CERBER_CAMERA_VPN_INTERFACE="<VPN_INTERFACE>"

# Copy to /opt/cerber-telemetry/runtime.env on the Jetson, mode 0600.
# Fill addresses from the existing, verified device configuration; do not commit it.
# Existing deployment used cerber-telemetry:20261102-v4. A rebuilt image needs its own tag.
CERBER_TELEMETRY_IMAGE=cerber-telemetry:20261102-rebuilt
RECEIVER_BIND_ADDRESS=REQUIRED_JETSON_ROBOT_INTERFACE_IPV4
ROBOT_ADDRESS=REQUIRED_ROBOT_SOURCE_IPV4
RECEIVER_PORT=43897
ROSBRIDGE_BIND_ADDRESS=REQUIRED_JETSON_VPN_IP
# Exact comma-separated TCP peers. Include the local VPN IP only if needed for probing.
ROSBRIDGE_ALLOWED_PEERS=REQUIRED_GATEWAY_VPN_IP
ROSBRIDGE_PORT=9090
